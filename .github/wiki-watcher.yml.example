# OPTIONAL — install this file in the *URBADAPT-HEAT* repository, at
# .github/workflows/wiki-watcher.yml
#
# Without it, wiki edits reach the website on the next daily rebuild (05:17 UTC).
# With it, a wiki edit publishes within about a minute.
#
# GitHub fires the `gollum` event in the code repository whenever a wiki page is
# created or edited. This workflow forwards that as a repository_dispatch to the
# website repo, whose deploy workflow listens for `wiki-updated`.
#
# Setup:
#   1. Create a fine-grained personal access token scoped to
#      URBADAPT/URBADAPT.github.io with "Contents: read and write" permission
#      (repository_dispatch requires write).
#   2. Add it to URBADAPT/URBADAPT-HEAT as the repository secret SITE_DISPATCH_TOKEN.
#   3. Commit this file to URBADAPT-HEAT as .github/workflows/wiki-watcher.yml.

name: Rebuild website on wiki edit

on:
  gollum

jobs:
  notify:
    runs-on: ubuntu-latest
    steps:
      - name: Trigger website rebuild
        env:
          GH_TOKEN: ${{ secrets.SITE_DISPATCH_TOKEN }}
        run: |
          gh api \
            --method POST \
            /repos/URBADAPT/URBADAPT.github.io/dispatches \
            -f event_type=wiki-updated
